# TrustLens training/deployment credentials.
#
# Copy this to `.env` and fill in real values ONLY on the machine that
# actually uses them (the GPU training server, or wherever the backend is
# deployed) -- never commit `.env`, never paste real values into a chat
# session. `.env`/`.env.*` are already gitignored; this file (`.env.example`)
# is the one exception meant to be tracked, and must stay placeholder-only.
#
# Load into your shell before running training scripts:
#   set -a && source .env && set +a

# --- Kaggle: dataset download in training/build_deepfake_manifest.py ---
# Get both values from https://www.kaggle.com/settings -> "Create New Token"
# (downloads a kaggle.json containing them). Alternative to setting these:
# save that file as ~/.kaggle/kaggle.json instead (chmod 600).
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Hugging Face Hub ---
# Used by training/finetune_deepfake.py (--hf-repo) to upload the trained
# checkpoint, and by backend/models/deepfake_model.py to download it if no
# local weights file exists. Needs "write" scope to allow uploads.
# Get a token from https://huggingface.co/settings/tokens
HF_TOKEN=

# Repo the trained deepfake weights get pushed to / pulled from.
# Pick your own, e.g. your-hf-username/trustlens-deepfake-b4
TRUSTLENS_DEEPFAKE_HF_REPO=

# --- Optional: where kagglehub caches downloaded datasets ---
# Point this at a partition with real free space -- equivalent to passing
# --cache-dir to build_deepfake_manifest.py; set one or the other, not both.
# KAGGLEHUB_CACHE=/tmp/YOUR_USERNAME/trustlens/kagglehub
